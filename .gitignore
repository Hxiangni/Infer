*.gcda
*.gcno
*.gcov
*.profraw
*.profdata

# ---------------- 模型与数据（不要提交权重文件） ----------------
# 开头的 / 表示只匹配仓库根目录下的 data/，
# 否则会把 include/data/、source/data/ 这些源码目录一起忽略掉
/data/
*.pnnx.param
*.pnnx.bin
*.onnx
*.pt
*.pth

# ---------------- IDE / 编辑器 ----------------
.idea/
.vscode/
.clangd/
.cache/
*.swp
*.swo
*~

# ---------------- 系统文件 ----------------
.DS_Store
Thumbs.db

# ---------------- 临时文件 / 日志 ----------------
*.tmp
*.log
*.bak

